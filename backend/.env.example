# Postgres — docker-compose.yml reads these for the container; keep in sync with DATABASE_URL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

DATABASE_URL="postgresql://spendit:spendit@localhost:5432/spendit?schema=public"

PORT=3001
WEB_ORIGIN=http://localhost:3000


FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
