generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiItemType {
  bill
  subscription
  insurance
  loan
  service
}

enum SiPaymentFrequency {
  daily
  weekly
  monthly
  bimonthly
  quarterly
  quadrimestral
  semiannual
  annually
}

model SiItem {
  id               String             @id @default(cuid())
  userId           String             @default("")
  type             SiItemType
  subType          String?
  paymentFrequency SiPaymentFrequency
  amount           Float              @db.Real
  notifyCancel     Boolean
  notifyRenew      Boolean
  notifyPay        Boolean
  notifyCancelDate DateTime?
  notifyRenewDate  DateTime?
  notifyPayDate    DateTime?

  @@index([userId])
  @@map("SI_Items")
}

model User {
  id          String   @id               // Firebase UID
  email       String   @unique
  displayName String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
